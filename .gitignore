# data/processed/*
# !data/processed/.gitkeep

# ---- Secrets ----
.env

# ---- Python ----
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# ---- Office temp / lock files ----
~$*
*.tmp

# ---- Editors and OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
